---
import '../styles/global.css';
import '@fontsource-variable/onest/wght.css';
import SiteHeader from '@/components/site/SiteHeader.astro';
import SiteFooter from '@/components/site/SiteFooter.astro';
import { site } from '@/lib/site-config';
import { absolute, asset } from '@/lib/utils';

export interface Props {
  title: string;
  description: string;
  /** Путь без base, например /blog/my-post/ */
  path: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  wide?: boolean;
  bodyClass?: string;
}

const { title, description, path, ogImage, noindex = false, jsonLd = [], wide = false, bodyClass = '' } = Astro.props;
const canonical = absolute(path);
const defaultOg = absolute(asset('/og/default.png'));
const lang = site.lang;
/* rules-allow: no-raw-colors — theme-color обязан быть литералом: CSS-токены ещё не загрузились */
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f5f5f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191b1c" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={absolute(asset('/rss.xml'))} />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/favicon.svg')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.wordmark} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage ?? defaultOg} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage ?? defaultOg} />

    {
      jsonLd.length > 0 && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd.length === 1 ? jsonLd[0] : jsonLd)} />
      )
    }

    <!-- Тема до первого рендера: без этого блока будет вспышка светлой темы. -->
    <script is:inline>
      (() => {
        const key = 'site-theme';
        let stored = null;
        try {
          stored = localStorage.getItem(key);
        } catch {}
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const theme = stored ?? system;
        const root = document.documentElement;
        root.setAttribute('data-theme', theme);
        root.setAttribute('data-theme-motion', 'off');
        root.style.colorScheme = theme;
        requestAnimationFrame(() => root.removeAttribute('data-theme-motion'));
      })();
    </script>
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">К содержимому</a>
    <SiteHeader />
    <main id="main" class={wide ? '' : 'shell'} data-wide={wide}>
      <slot />
    </main>
    <SiteFooter />
    <style is:global>
      .skip-link {
        position: absolute;
        inset-inline-start: 12px;
        inset-block-start: -48px;
        z-index: 70;
        padding: 10px 16px;
        border-radius: 0 0 var(--radius-sm) var(--radius-sm);
        background: var(--c-accent);
        color: var(--c-accent-ink);
        font: var(--type-body-3);
        letter-spacing: var(--tracking-body-3);
        text-decoration: none;
        transition: inset-block-start var(--duration-base) var(--ease-glide);
      }

      .skip-link:focus-visible {
        inset-block-start: 0;
      }

      main[data-wide] > * {
        inline-size: 100%;
      }

      body {
        background: var(--c-bg);
      }
    </style>
  </body>
</html>
