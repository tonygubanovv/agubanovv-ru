---
import type { CollectionEntry, RenderResult } from 'astro:content';
import Base from './Base.astro';
import { site } from '@/lib/site-config';
import { absolute, asset, catalogHref, formatDate, p, readingTime } from '@/lib/utils';

export interface Props {
  entry: CollectionEntry<'blog'>;
  rendered: RenderResult;
  related: CollectionEntry<'blog'>[];
}

const { entry, rendered, related } = Astro.props;
const { data, id: slug, body } = entry;
const base = data.kind === 'case' ? '/cases' : '/blog';
const path = `${base}/${slug}/`;
const { minutes } = readingTime(body ?? '');
const isCase = data.kind === 'case';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': isCase ? 'Article' : 'Article',
    headline: data.seo.title ?? data.title,
    description: data.seo.description ?? data.dek,
    datePublished: data.date.toISOString(),
    dateModified: (data.updated ?? data.date).toISOString(),
    inLanguage: site.locale,
    author: { '@type': 'Organization', name: site.wordmark },
    mainEntityOfPage: { '@type': 'WebPage', '@id': absolute(path) },
    ...(data.cover ? { image: absolute(asset(data.cover.src)) } : {}),
  },
];
---

<Base
  title={`${data.seo.title ?? data.title} — ${site.wordmark}`}
  description={data.seo.description ?? data.dek}
  path={path}
  noindex={data.noindex}
  ogImage={data.cover ? absolute(asset(data.cover.src)) : undefined}
  jsonLd={jsonLd}
  wide
>
  <div class="material shell">
    <header class="material-head">
      <a class="material-back" href={catalogHref()}>← Все материалы</a>
      <h1 class="material-title">{data.title}</h1>
      <p class="material-dek">{data.dek}</p>

      <p class="material-meta">
        <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time> · {minutes} мин чтения
      </p>
    </header>

    {
      isCase && (
        <ul class="case-metrics glow-box" aria-label="Результаты проекта">
          {data.metrics.slice(0, 2).map((metric) => (
            <li class="metric-card">
              <span class="metric-value">{metric.value}</span>
              <span class="metric-label">{metric.label}</span>
            </li>
          ))}
        </ul>
      )
    }
    <div class="material-grid">
      <article class="prose material-body">
        {
          data.cover && (
            <figure class="material-cover">
              <img src={asset(data.cover.src)} alt={data.cover.alt} width="1320" height="620" />
            </figure>
          )
        }
        <rendered.Content />
      </article>
    </div>

    {
      related.length > 0 && (
        <section class="related">
          <h2>Ещё по теме</h2>
          <ul>
            {related.slice(0, 2).map((item) => (
              <li>
                <a href={p((item.data.kind === 'case' ? '/cases/' : '/blog/') + item.id + '/')}>{item.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .material {
    padding-block-start: var(--spacing-section);
  }
  .material-head,
  .material-grid,
  .case-metrics,
  .related {
    max-inline-size: var(--container-read);
    margin-inline: auto;
  }
  .material-head {
    display: grid;
    gap: 24px;
  }
  .material-back {
    font: var(--type-body-3);
    letter-spacing: var(--tracking-body-3);
    color: var(--c-muted);
    text-decoration: none;
    margin-block-end: 8px;
  }
  .material-title {
    font: var(--type-title-2);
    letter-spacing: var(--tracking-title-2);
    line-height: 1.08;
  }
  .material-dek {
    font: var(--type-subtitle-2);
    letter-spacing: var(--tracking-subtitle-2);
    color: var(--c-ink-soft);
    max-inline-size: 60ch;
  }
  .material-meta {
    font: var(--type-body-3);
    letter-spacing: var(--tracking-body-3);
    color: var(--c-muted);
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .material-meta time {
    padding: 4px 10px;
    border: 1px solid var(--c-tech-line);
    border-radius: var(--radius-pill);
    background: var(--c-bg-sunk);
  }
  .material-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-block-start: 48px;
    border-block-start: 1px solid var(--c-tech-line);
    padding-block-start: 40px;
  }
  .material-body {
    min-inline-size: 0;
  }
  .material-cover {
    margin: 0 0 32px;
    border: 1px solid var(--c-tech-line);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--sh-3);
  }
  .case-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    padding: 32px 0;
    margin-block: 40px 0;
    list-style: none;
    border-block: 1px solid var(--c-line);
  }
  .case-metrics li {
    display: grid;
    gap: 8px;
  }
  .metric-card {
    padding: 20px;
    border: 1px solid var(--c-tech-line);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    transition:
      border-color var(--duration-base) var(--ease-glide),
      box-shadow var(--duration-base) var(--ease-glide);
  }
  .metric-card:hover {
    border-color: var(--c-glow-line);
    box-shadow: var(--shadow-glow);
  }
  .case-metrics .metric-value {
    color: var(--c-accent);
  }
  .related {
    margin-block-start: var(--spacing-section);
    padding-block-start: 32px;
    border-block-start: 1px solid var(--c-line);
  }
  .related h2 {
    font: var(--type-title-4);
    letter-spacing: var(--tracking-title-4);
  }
  .related ul {
    display: grid;
    gap: 16px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .related a {
    color: var(--c-accent);
    text-decoration: none;
  }
  .related a:hover {
    color: var(--c-secondary-ink);
  }
</style>
