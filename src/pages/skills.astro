---
import BaseLayout from '../layouts/BaseLayout.astro';

const groups = [
  {
    title: 'Реклама и лидогенерация',
    description: 'Запускаю кампании, тестирую площадки и объявления. Слежу не только за заявками, но и за их качеством.',
    skills: ['Яндекс Директ', 'Telegram Ads', 'VK Ads', 'Посевы в Telegram', 'Лидогенерация', 'UTM-метки', 'Оптимизация кампаний', 'Тестирование креативов'],
  },
  {
    title: 'SEO и контент',
    description: 'Работаю над поисковыми показателями сайта: от структуры и контента до технических задач.',
    skills: ['SEO', 'Техническое SEO', 'Структура сайта', 'Контент-маркетинг', 'Google Search Console', 'Анализ поискового трафика', 'GEO'],
  },
  {
    title: 'Развитие сайта',
    description: 'Веду веб-задачи со стороны маркетинга: собираю бэклог, расставляю приоритеты и проверяю результат перед релизом.',
    skills: ['Постановка ТЗ', 'Управление бэклогом', 'Приоритизация', 'Релиз-ноутсы', 'Контроль качества', 'Работа с разработчиками', 'Tilda', 'GitHub'],
  },
  {
    title: 'Веб- и сквозная аналитика',
    description: 'Настраиваю аналитику и разбираюсь, какие каналы приводят заявки, а какие просто тратят бюджет.',
    skills: ['Яндекс Метрика', 'Google Analytics 4', 'Roistat', 'Сквозная аналитика', 'Веб-аналитика', 'Анализ конверсий', 'Атрибуция', 'Отчётность'],
  },
  {
    title: 'CRM и автоматизация',
    description: 'Работаю с клиентской базой и входящими лидами. Настраиваю сценарии в Salesbot и слежу, чтобы заявки не терялись.',
    skills: ['amoCRM', 'Salesbot', 'Telegram-боты', 'Сегментация базы', 'Контроль лидов', 'Качество лидов', 'Mango Office'],
  },
  {
    title: 'Email-маркетинг',
    description: 'Готовлю рассылки, работаю с базой и смотрю на доставляемость и результаты писем.',
    skills: ['Sendsay', 'Email-рассылки', 'Сегментация базы', 'Рост базы', 'Доставляемость', 'Анализ открытий', 'Конверсии рассылок'],
  },
  {
    title: 'Репутация и карты',
    description: 'Поддерживаю актуальность карточек компании, отслеживаю отзывы и помогаю выстроить работу с обратной связью.',
    skills: ['Яндекс Карты', '2ГИС', 'Google Карты', 'Работа с отзывами', 'Мониторинг репутации', 'Карточки организаций'],
  },
  {
    title: 'Работа с командой',
    description: 'Согласовываю задачи с продажами, разработчиками, дизайнерами и авторами. Беру на себя и операционные вопросы.',
    skills: ['B2B-маркетинг', 'IT и информационная безопасность', 'Кросс-функциональные задачи', 'Постановка задач', 'Работа с продажами', 'Координация команды', 'Проверка гипотез'],
  },
];
---
<BaseLayout path="skills/">
  <section class="container page-content skills-page">
    <header class="page-heading skills-intro">
      <p class="skills-eyebrow">Digital / B2B / IT</p>
      <h1>Навыки<span class="brand-dot">.</span></h1>
      <p class="skills-lead">Занимаюсь рекламой, сайтом, аналитикой и работой с лидами. Здесь собрал основные направления и инструменты, с которыми работаю.</p>
    </header>

    <div class="skills-groups">
      {groups.map((group, index) => (
        <section class="skills-group" aria-labelledby={`skills-group-${index + 1}`}>
          <div class="skills-group-copy">
            <div class="skills-group-heading">
              <span class="skills-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h2 id={`skills-group-${index + 1}`}>{group.title}</h2>
            </div>
            <p>{group.description}</p>
          </div>
          <ul class="skills-chips" aria-label={`Навыки: ${group.title}`}>
            {group.skills.map(skill => <li class="skills-chip">{skill}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .skills-page { padding-bottom: var(--space-9); }
  .skills-intro { padding-bottom: var(--space-7); margin-bottom: 0; }
  .skills-eyebrow { color: var(--accent); font-size: var(--text-2); font-weight: 600; letter-spacing: .04em; line-height: 1.4; margin-bottom: var(--space-3); }
  .skills-intro h1 { margin: 0; }
  .skills-intro .skills-lead { max-width: 700px; margin-top: var(--space-5); color: var(--foreground); font-size: var(--text-4); line-height: 1.65; }
  .skills-groups { border-top: 1px solid var(--border); }
  .skills-group { display: grid; grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr); gap: var(--space-7); align-items: start; padding-block: var(--space-6); border-bottom: 1px solid var(--border); }
  .skills-group-copy { min-width: 0; }
  .skills-group-heading { display: flex; align-items: baseline; gap: var(--space-4); }
  .skills-number { flex: 0 0 auto; color: var(--accent); font-size: var(--text-2); font-weight: 650; line-height: 1.35; font-variant-numeric: tabular-nums; }
  .skills-group h2 { font-size: var(--text-5); line-height: 1.3; }
  .skills-group-copy > p { margin: var(--space-3) 0 0; padding-left: calc(var(--space-4) + 2ch); color: var(--muted); font-size: var(--text-2); line-height: 1.65; max-width: 410px; }
  .skills-chips { display: flex; flex-wrap: wrap; align-content: start; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  .skills-chip { display: inline-flex; align-items: center; min-height: 34px; max-width: 100%; padding: 6px var(--space-3); border: 1px solid var(--border); border-radius: var(--radius-pill); background: var(--card-background); color: var(--foreground); font-size: var(--text-2); line-height: 1.4; overflow-wrap: anywhere; cursor: text; user-select: text; }
  @media (max-width: 850px) {
    .skills-group { grid-template-columns: 1fr; gap: var(--space-5); }
    .skills-group-copy > p { max-width: 650px; }
  }
  @media (max-width: 700px) {
    .skills-intro { padding-bottom: var(--space-6); }
    .skills-intro .skills-lead { font-size: var(--text-3); }
    .skills-group { padding-block: var(--space-5); gap: var(--space-4); }
    .skills-group-heading { gap: var(--space-3); }
    .skills-group h2 { font-size: var(--text-4); }
    .skills-group-copy > p { padding-left: 0; }
    .skills-chip { min-height: 32px; padding: 5px var(--space-3); }
  }
</style>
