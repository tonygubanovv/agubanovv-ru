---
import BaseLayout from '../layouts/BaseLayout.astro';
import { skillGroups } from '../config/site';
---
<BaseLayout path="skills/">
  <section class="container page-content">
    <div class="page-heading">
      <h1>Навыки<span class="brand-dot">.</span></h1>
      <p>Основные направления и инструменты, с которыми работаю.</p>
    </div>

    <div class="skills-grid">
      {skillGroups.map(group => (
        <section class="skills-group">
          <h2>{group.title}</h2>
          <ul class="tags skills-tags">
            {group.skills.map(skill => <li class="tag">{skill}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .skills-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-7); }
  .skills-group { min-width: 0; border-top: 1px solid var(--border); padding-top: var(--space-4); }
  .skills-group h2 { font-size: var(--text-5); }
  .skills-tags { list-style: none; margin-top: var(--space-4); padding: 0; }
  @media (max-width: 700px) {
    .skills-grid { grid-template-columns: 1fr; }
  }
</style>
