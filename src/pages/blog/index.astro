---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { blogTags } from '../../config/site';
import { blogEntries } from '../../utils/content';
import { url, tagSlug } from '../../utils/urls';
const posts = await blogEntries();
const tags = blogTags.filter(tag => posts.some(post => post.data.tags.includes(tag)));
---
<BaseLayout title="Блог" description="Статьи и кейсы Антона Губанова о digital-маркетинге, рекламе, SEO, GEO и ИИ: эксперименты, разбор инструментов и выводы из практики." path="blog/">
  <div class="container page-content"><div class="page-heading"><h1>Блог<span class="brand-dot">.</span></h1><p>Разбираю инструменты и проверяю гипотезы. Рассказываю, как устроен эксперимент и что получилось в результате.</p></div>
    {tags.length > 0 && <nav class="tags tag-filter" aria-label="Темы блога">{tags.map(tag => <a class="tag" href={url(`blog/tags/${tagSlug(tag)}/`)}>{tag}</a>)}</nav>}
    {posts.length ? <div class="card-grid">{posts.map(entry => <ContentCard entry={entry} />)}</div> : <EmptyState kind="blog" />}
    <div class="page-note"><span class="status-dot" aria-hidden="true"></span> Материалы можно обсудить со мной в Telegram.</div>
  </div>
</BaseLayout>
