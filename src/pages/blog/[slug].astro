---
import { getCollection, getEntry, render } from 'astro:content';
import Material from '@/layouts/Material.astro';

export async function getStaticPaths() {
  const articles = await getCollection('blog', ({ data }) => data.kind === 'article' && !data.draft);
  return articles.map((entry) => ({ params: { slug: entry.id } }));
}

const slug = Astro.params.slug as string;
const entry = (await getEntry('blog', slug))!;
const rendered = await render(entry);

const all = await getCollection('blog', ({ data }) => !data.draft);
const declared = entry.data.related
  .map((slugToFind) => all.find((item) => item.id === slugToFind))
  .filter((item): item is (typeof all)[number] => Boolean(item));
const byTopic = all
  .filter((item) => item.id !== slug && !entry.data.related.includes(item.id))
  .filter((item) => item.data.topic === entry.data.topic || item.data.kind !== entry.data.kind)
  .slice(0, 2);
const related = (declared.length ? declared : byTopic).slice(0, 3);
---

<Material entry={entry} rendered={rendered} related={related.slice(0, 3)} />
