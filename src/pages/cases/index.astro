---
import { p } from '@/lib/utils';

/**
 * Кейсы больше не отдельный раздел: они живут в общем каталоге с фильтром
 * по типу. Страница оставлена как заглушка-редирект, чтобы старые ссылки
 * и закладчики не вели в 404.
 */
const to = `${p('/blog/')}#kind=case`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <title>Кейсы — в общем каталоге разборов</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={to} />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <script is:inline define:vars={{ to }}>
      location.replace(to);
    </script>
    <style is:inline>
      /* rules-allow: no-raw-colors — редирект-заглушка рендерится без дизайн-токенов */
      body {
        margin: 0;
        display: grid;
        place-content: center;
        min-block-size: 100dvh;
        font:
          16px/1.6 system-ui,
          sans-serif;
        background: #f8f6f1;
        color: #2b2a24;
      }
      a {
        color: #b4552d;
      }
    </style>
  </head>
  <body>
    <p>
      Кейсы переехали в общий каталог:
      <a href={to}>все разборы с фильтром «Кейсы»</a>.
    </p>
  </body>
</html>
