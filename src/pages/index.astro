---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Catalog from '@/components/content/Catalog.astro';
import SectionHead from '@/components/content/SectionHead.astro';
import { contact, hero, materials, toolsTeaser } from '@/lib/copy/home';
import { site, topics } from '@/lib/site-config';
import { tools } from '@/lib/tools';
import { absolute, p } from '@/lib/utils';

const published = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    jobTitle: 'Продуктовый маркетолог',
    description: site.description,
    url: absolute('/'),
    knowsAbout: topics.map((topic) => topic.title),
    sameAs: [`https://t.me/${site.contact.telegram.replace(/^@/, '')}`, site.contact.github],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.wordmark,
    url: absolute('/'),
    inLanguage: site.locale,
  },
];
---

<Base title={site.title} description={site.description} path="/" jsonLd={jsonLd} wide>
  <section class="hero shell">
    <div class="hero-content">
      <h1>{hero.title}</h1>
      <p class="hero-lead">{hero.lead}</p>
      <a class="btn btn-primary" href="#contact">{hero.action}</a>
    </div>
  </section>
  <section class="section shell" id="materials">
    <Catalog
      entries={published}
      scope="all"
      limit={2}
      title={materials.title}
      moreHref="/blog/"
      moreLabel={materials.more}
    />
  </section>
  <section class="section shell" id="tools">
    <SectionHead title={toolsTeaser.title} />
    {
      tools
        .filter((tool) => tool.status === 'live')
        .map((tool) => (
          <a class="tool-row" href={p('/tools/' + tool.slug + '/')}>
            <>
              <h3>{tool.name}</h3>
              <p>{tool.tagline}</p>
              <span aria-hidden="true">→</span>
            </>
          </a>
        ))
    }
  </section>
  <section class="section shell" id="contact">
    <div class="contact-panel">
      <h2>{contact.title}</h2>
      <p>{contact.body}</p>
      <a class="btn btn-primary" href={'mailto:' + site.contact.email}>{contact.action}</a>
    </div>
  </section>
</Base>
<style>
  .hero {
    padding-block-start: var(--spacing-section);
  }
  .hero-content {
    display: grid;
    justify-items: start;
    gap: 24px;
    max-inline-size: 760px;
  }
  .hero h1 {
    font: var(--type-title-1);
    letter-spacing: var(--tracking-title-1);
    max-inline-size: 23ch;
  }
  .hero-lead {
    font: var(--type-subtitle-2);
    letter-spacing: var(--tracking-subtitle-2);
    color: var(--c-ink-soft);
    max-inline-size: 58ch;
  }
  .hero-proof {
    margin-block-start: 8px;
    font: var(--type-body-3);
    letter-spacing: var(--tracking-body-3);
    color: var(--c-muted);
  }
  .tool-row {
    display: grid;
    gap: 12px;
    padding-block: 32px;
    border-block: 1px solid var(--c-line);
    text-decoration: none;
  }
  .tool-row h3 {
    font: var(--type-title-4);
    letter-spacing: var(--tracking-title-4);
  }
  .tool-row p {
    color: var(--c-muted);
    font: var(--type-body-2);
    letter-spacing: var(--tracking-body-2);
  }
  .tool-row > span {
    color: var(--c-accent);
  }
  .tool-row:hover h3 {
    color: var(--c-secondary-ink);
  }
  .contact-panel {
    display: grid;
    justify-items: start;
    gap: 24px;
    max-inline-size: 640px;
  }
  .contact-panel p {
    color: var(--c-ink-soft);
  }
  @media (min-width: 1280px) {
    .tool-row {
      grid-template-columns: 1fr 1.5fr auto;
      align-items: center;
      gap: 48px;
    }
  }
</style>
