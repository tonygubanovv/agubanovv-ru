---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/about/anton-gubanov.png';
import SectionHeader from '../components/SectionHeader.astro';
import Kicker from '../components/Kicker.astro';
import EmptyState from '../components/EmptyState.astro';
import ContentCard from '../components/ContentCard.astro';
import { site, contactLinks } from '../config/site';
import Icon from '../components/Icon.astro';
import { url, absoluteUrl } from '../utils/urls';
import { blogEntries } from '../utils/content';
const posts = (await blogEntries()).slice(0, 3);
---
<BaseLayout title="Маркетинг, SEO и Telegram Ads" description={site.description} jsonLd={{ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: absoluteUrl(), inLanguage: 'ru-RU' }}>
  <section class="hero container">
    <div class="hero-copy">
      <h1>{site.hero.title}{' '}<span>{site.hero.accent}</span></h1>
      <p class="hero-description">{site.hero.description}</p>
      <div class="hero-actions"><a class="button primary" href={url('blog/')}>Читать блог <Icon /></a></div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 440 440" fill="none">
        <defs><linearGradient id="orbit" x1="60" y1="70" x2="380" y2="370" gradientUnits="userSpaceOnUse"><stop stop-color="currentColor" stop-opacity=".9"/><stop offset="1" stop-color="currentColor" stop-opacity=".12"/></linearGradient></defs>
        <circle cx="220" cy="220" r="160" stroke="currentColor" stroke-opacity=".15"/><circle cx="220" cy="220" r="116" stroke="currentColor" stroke-opacity=".2"/>
        <path d="M40 220h360M220 40v360" stroke="currentColor" stroke-opacity=".13" stroke-dasharray="3 7"/>
        <g class="atom-orbits">
        <ellipse cx="220" cy="220" rx="188" ry="74" transform="rotate(-35 220 220)" stroke="url(#orbit)" stroke-width="1.5"/>
        <ellipse cx="220" cy="220" rx="162" ry="64" transform="rotate(42 220 220)" stroke="url(#orbit)" stroke-width="1.5"/>
        </g>
        <circle cx="220" cy="220" r="7" fill="currentColor"/>
        <circle cx="220" cy="220" r="17" stroke="currentColor" stroke-opacity=".35"/>
        <g class="atom-particles">
        <circle cx="353" cy="119" r="7" fill="currentColor"/><circle cx="91" cy="116" r="4" fill="currentColor"/><circle cx="278" cy="368" r="4" fill="currentColor"/>
        </g>
        <path d="M48 65h20M58 55v20M370 332h20M380 322v20" stroke="currentColor" stroke-opacity=".6"/>
      </svg>
    </div>
  </section>
  <section id="about" class="about-section container section-space">
    <div class="about-label"><SectionHeader number="01 /" title="Обо мне" /></div>
    <div class="about-copy">
      <div class="about-portrait"><Image src={portrait} alt="Антон Губанов" widths={[128, 256]} sizes="(max-width: 700px) 80px, (max-width: 1000px) 96px, 112px" quality={75} loading="lazy" decoding="async" /></div>
      <p>{site.about.intro}</p>
      <details class="about-more">
        <summary><span class="about-expand-label">Подробнее</span>{' '}<span class="about-collapse-label">Свернуть</span><Icon direction="down" size={16} /></summary>
        <div class="about-story">{site.about.more.map(paragraph => <p>{paragraph}</p>)}</div>
      </details>
    </div>
  </section>
  <section class="container section-space">
    <SectionHeader number="02 /" title="Блог" href={url('blog/')} label="Весь блог" />
    {posts.length ? <div class="card-grid">{posts.map(entry => <ContentCard entry={entry} heading="h3" />)}</div> : <EmptyState kind="blog" heading="h3" />}
  </section>
  {contactLinks().length > 0 && <section class="container contact-section"><div><Kicker>Есть вопрос или идея?</Kicker><h2>Напишите мне<span class="brand-dot">.</span></h2></div><div class="contact-links">{contactLinks().map(link => link.key === 'email' ? <a class="contact-email" href={link.url}>{link.label}</a> : <a class="button secondary" href={link.url}>{link.label} <Icon /></a>)}</div></section>}
</BaseLayout>
