---
import { site } from '../config/site';
import { url } from '../utils/urls';
const { yandexId, privacyApproved } = site.analytics;
const enabled = privacyApproved && Number.isSafeInteger(yandexId) && Number(yandexId) > 0;
const publicHostname = new URL(import.meta.env.SITE!).hostname;
const { consentVersion, consentDays } = site.legal;
---
{enabled && <aside class="cookie-notice" data-cookie-notice role="region" aria-label="Настройки cookie" hidden>
  <div class="cookie-notice-inner">
  <p>Cookie для аналитики?</p><a class="cookie-terms" href={url('consent/')}>Условия</a>
  <div class="cookie-notice-actions"><button class="button primary" type="button" data-cookie-accept aria-label="Разрешить аналитику">Да</button><button class="button secondary" type="button" data-cookie-decline aria-label="Отказаться от аналитики">Нет</button></div>
  </div>
</aside>}
{enabled && <script is:inline define:vars={{ counterId: yandexId, publicHostname, consentVersion, consentDays }}>
  (function () {
    const storageKey = 'agubanovv:analytics-consent';
    const duration = consentDays * 86400000;
    const notice = document.querySelector('[data-cookie-notice]');
    const settings = document.querySelectorAll('[data-cookie-settings]');
    let loaded = false;
    let returnFocus = null;
    function readChoice() {
      try {
        const choice = JSON.parse(localStorage.getItem(storageKey));
        const now = Date.now();
        return choice && choice.version === consentVersion && typeof choice.accepted === 'boolean'
          && Number.isFinite(choice.at) && choice.at <= now && now - choice.at < duration ? choice : null;
      } catch { return null; }
    }
    function clearAnalyticsStorage() {
      try {
        Object.keys(localStorage).filter(key => /^_ym/.test(key)).forEach(key => localStorage.removeItem(key));
      } catch { /* Storage can be unavailable. */ }
      try {
      const names = document.cookie.split(';').map(item => item.trim().split('=')[0]).filter(name => /^_ym/.test(name));
      const domains = [null, location.hostname, '.' + location.hostname];
      for (const name of names) for (const domain of domains) {
        document.cookie = name + '=; Max-Age=0; path=/' + (domain ? '; domain=' + domain : '') + '; SameSite=Lax';
      }
      } catch { /* Cookies can be unavailable. */ }
    }
    function startAnalytics(choice) {
      if (loaded || !choice || !choice.accepted || location.hostname !== publicHostname) return;
      loaded = true;
      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r)return;}
        k=e.createElement(t);a=e.getElementsByTagName(t)[0];k.async=1;k.src=r;a.parentNode.insertBefore(k,a);
      })(window,document,'script','https://mc.yandex.ru/metrika/tag.js?id='+counterId,'ym');
      ym(counterId,'init',{ssr:true,webvisor:true,clickmap:true,referrer:document.referrer,url:location.href,accurateTrackBounce:true,trackLinks:true,
        params:{analyticsConsent:{version:choice.version,grantedAt:new Date(choice.at).toISOString()}}});
    }
    function stopAnalytics() {
      if (loaded && typeof window.ym === 'function') window.ym(counterId,'destruct');
      clearAnalyticsStorage();
      if (loaded) location.reload();
    }
    function apply(choice) {
      if (notice) notice.hidden = !!choice;
      if (choice && choice.accepted) startAnalytics(choice);
      else stopAnalytics();
    }
    function saveChoice(accepted) {
      const choice = {version:consentVersion,accepted,at:Date.now()};
      try { localStorage.setItem(storageKey, JSON.stringify(choice)); } catch { /* Choice still applies to this page. */ }
      apply(choice);
      if (returnFocus) { returnFocus.focus(); returnFocus = null; }
    }
    document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => saveChoice(true));
    document.querySelector('[data-cookie-decline]')?.addEventListener('click', () => saveChoice(false));
    settings.forEach(button => {
      button.hidden = false;
      button.addEventListener('click', () => {
        returnFocus = button;
        if (notice) notice.hidden = false;
        document.querySelector('[data-cookie-accept]')?.focus();
      });
    });
    window.addEventListener('storage', event => { if (event.key === storageKey || event.key === null) apply(readChoice()); });
    document.addEventListener('visibilitychange', () => { if (!document.hidden) apply(readChoice()); });
    // Consent is checked again before every page view; scrolling never grants it.
    apply(readChoice());
  })();
</script>}
