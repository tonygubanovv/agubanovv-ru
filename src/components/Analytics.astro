---
import { site } from '../config/site';
// Both a real counter ID and explicit privacy approval are required.
const { yandexId, privacyApproved } = site.analytics;
const enabled = privacyApproved && Number.isSafeInteger(yandexId) && Number(yandexId) > 0;
---
{enabled && <script is:inline define:vars={{ counterId: yandexId }}>
  window.ym = window.ym || ((...args) => { (window.ym.a = window.ym.a || []).push(args); });
  window.ym.l = Date.now();
  const script = document.createElement('script');
  script.async = true;
  script.src = 'https://mc.yandex.ru/metrika/tag.js';
  document.head.append(script);
  window.ym(counterId, 'init', { clickmap: false, trackLinks: true, accurateTrackBounce: true, webvisor: false });
</script>}
