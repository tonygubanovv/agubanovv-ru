---
import { url } from '../utils/urls';
import { trail } from '../utils/crumbs';
interface Props { current?: string; bare?: boolean }
const { current, bare = false } = Astro.props;
// The address of the page being built gives the whole chain; a page only names its own last step.
const crumbs = trail(Astro.url.pathname, current);
const last = crumbs.length - 1;
---
{crumbs.length > 1 && <nav class="breadcrumbs" aria-label="Хлебные крошки">
  <div class:list={['breadcrumbs-inner', !bare && 'container']}>
    {crumbs.map((crumb, index) => <span class="breadcrumb-item">
      {index > 0 && <span aria-hidden="true">/</span>}
      {index === last ? <span class="breadcrumbs-current" aria-current="page">{crumb.label}</span> : <a href={url(crumb.path)}>{crumb.label}</a>}
    </span>)}
  </div>
</nav>}
