---
import type { CollectionEntry } from 'astro:content';
import { p } from '@/lib/utils';
export interface Props {
  entry: CollectionEntry<'blog'>;
}
const { entry } = Astro.props;
const { data, id } = entry;
const href = p(`${data.kind === 'case' ? '/cases' : '/blog'}/${id}/`);
---

<article class="material-card">
  <a class="material-link" href={href}>
    <span class="material-kind">{data.kind === 'case' ? 'Кейс' : 'Заметка'}</span>
    <h3>{data.title}</h3>
    <p>{data.dek}</p>
  </a>
</article>
<style>
  .material-card {
    min-inline-size: 0;
    border-block-start: 1px solid var(--c-line);
  }
  .material-link {
    display: grid;
    align-content: start;
    gap: 12px;
    block-size: 100%;
    padding-block: 24px;
    text-decoration: none;
  }
  .material-kind {
    font: var(--type-body-3);
    letter-spacing: var(--tracking-body-3);
    color: var(--c-muted);
  }
  .material-link h3 {
    font: var(--type-title-4);
    letter-spacing: var(--tracking-title-4);
    max-inline-size: 32ch;
    transition: color var(--duration-base) var(--ease-glide);
  }
  .material-link p {
    font: var(--type-body-2);
    letter-spacing: var(--tracking-body-2);
    color: var(--c-muted);
    max-inline-size: 58ch;
  }
  .material-link:hover h3 {
    color: var(--c-secondary-ink);
  }
</style>
