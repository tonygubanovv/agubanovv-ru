---
import Icon from './Icon.astro';
import Kicker from './Kicker.astro';
interface Props { kind: 'blog' | 'tags'; heading?: 'h2' | 'h3' }
const { kind, heading: Heading = 'h2' } = Astro.props;
const states = {
  blog: { title: 'Здесь начнётся разговор', text: 'Пока готовлю первые материалы. Здесь появятся заметки о маркетинге, инструментах и практическом опыте.', label: 'Первая публикация впереди', icon: 'article' },
  tags: { title: 'Темы появятся вместе со статьями', text: 'Когда выйдут первые публикации, здесь можно будет выбрать интересующую тему.', label: 'Пока без тегов', icon: 'tag' },
} as const;
const state = states[kind];
---
<div class="empty-state">
  <div class="empty-icon" aria-hidden="true"><Icon name={state.icon} size={28} /></div>
  <div class="empty-copy"><Kicker>{state.label}</Kicker><Heading>{state.title}</Heading><p>{state.text}</p></div>
  <div class="empty-decoration" aria-hidden="true"><span></span><span></span><span></span></div>
</div>
