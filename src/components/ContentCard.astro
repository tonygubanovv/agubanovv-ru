---
import type { CollectionEntry } from 'astro:content';
import { dateLabel, publicationPath } from '../utils/content';
import { url } from '../utils/urls';
import Icon from './Icon.astro';
interface Props { entry: CollectionEntry<'blog'>; heading?: 'h2' | 'h3' }
const { entry, heading: Heading = 'h2' } = Astro.props;
const { data } = entry;
---
<article class="content-card">
  <img src={data.cover.src.src} alt={data.cover.alt} width={data.cover.src.width} height={data.cover.src.height} loading="lazy" decoding="async" />
  <div class="card-body">
    <time class="meta" datetime={data.date}>{dateLabel(data.date)}</time>
    <Heading><a href={url(publicationPath(entry))}>{data.title} <Icon /></a></Heading>
    <p>{data.description}</p>
  </div>
</article>
