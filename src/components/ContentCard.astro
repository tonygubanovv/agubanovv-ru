---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { dateLabel, publicationPath } from '../utils/content';
import { url } from '../utils/urls';
import Icon from './Icon.astro';
interface Props { entry: CollectionEntry<'blog'>; heading?: 'h2' | 'h3' }
const { entry, heading: Heading = 'h2' } = Astro.props;
const { data } = entry;
---
<article class="content-card">
  <Image src={data.cover.src} alt={data.cover.alt} width={720} widths={[360, 720]} sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw" format="webp" loading="lazy" />
  <div class="card-body">
    <time class="meta" datetime={data.date}>{dateLabel(data.date)}</time>
    <Heading><a href={url(publicationPath(entry))}>{data.title} <Icon /></a></Heading>
    <p>{data.description}</p>
  </div>
</article>
