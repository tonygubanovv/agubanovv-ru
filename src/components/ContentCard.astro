---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { dateLabel, publicationPath } from '../utils/content';
import { url } from '../utils/urls';
import Icon from './Icon.astro';
interface Props { entry: CollectionEntry<'blog'>; heading?: 'h2' | 'h3' }
const { entry, heading: Heading = 'h2' } = Astro.props;
const { data } = entry;
// Three columns on a wide screen, two in the middle, one on a phone: the browser picks the variant by these widths.
const cardSizes = '(min-width: 1001px) 352px, (min-width: 701px) 47vw, calc(100vw - 48px)';
---
<article class="content-card">
  <Image src={data.cover.src} alt={data.cover.alt} widths={[400, 720, 1080]} sizes={cardSizes} quality={72} loading="lazy" decoding="async" />
  <div class="card-body">
    <time class="meta" datetime={data.date}>{dateLabel(data.date)}</time>
    <Heading><a href={url(publicationPath(entry))}>{data.title} <Icon /></a></Heading>
    <p>{data.description}</p>
  </div>
</article>
