---
import type { ComponentProps } from 'astro/types';
import Icon from './Icon.astro';
import { url } from '../utils/urls';
type MenuItem = { label: string; path: string; description: string; icon: ComponentProps<typeof Icon>['name'] };
interface Props { items: readonly MenuItem[]; compact?: boolean }
const { items, compact = false } = Astro.props;
---
<ul class:list={['menu-links', { compact }]}>
  {items.map(item => <li><a class="menu-link" href={url(item.path)} aria-current={Astro.url.pathname === url(item.path) ? 'page' : undefined}>
    <Icon name={item.icon} size={compact ? 16 : 20} />
    <span><span class="menu-title">{item.label}</span>{!compact && <>{' '}<span class="menu-description">{item.description}</span></>}</span>
  </a></li>)}
</ul>
<style>
  .menu-links { display: grid; gap: var(--space-1); list-style: none; margin: 0; padding: 0; }
  .menu-link { display: grid; grid-template-columns: var(--space-5) minmax(0, 1fr); align-items: start; gap: var(--space-2); min-height: var(--tap); height: 100%; padding: var(--space-3); border: 1px solid transparent; border-radius: var(--radius-md); color: var(--foreground); }
  .menu-link:hover { color: var(--foreground); }
  .menu-link:active, .menu-link:focus-visible { background: var(--card-background); border-color: var(--border); }
  .menu-link > :global(.icon) { justify-self: center; color: var(--muted); margin-top: var(--space-1); }
  .menu-link:active > :global(.icon), .menu-link:focus-visible > :global(.icon), .menu-link[aria-current] > :global(.icon), .menu-link[aria-current] .menu-title { color: var(--accent); }
  @media (hover: hover) and (pointer: fine) {
    .menu-link:hover { color: var(--accent); background: var(--card-background); border-color: var(--border); }
    .menu-link:hover > :global(.icon) { color: var(--accent); }
  }
  .menu-title, .menu-description { display: block; }
  .menu-title { font-size: var(--text-2); font-weight: 600; line-height: 1.4; }
  .menu-description { margin-top: var(--space-1); color: var(--muted); font-size: var(--text-1); font-weight: 400; line-height: 1.5; }
  .compact { display: flex; align-items: center; gap: var(--space-2); }
  .compact .menu-link { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-3); }
  .compact .menu-link > :global(.icon) { margin-top: 0; }
</style>
