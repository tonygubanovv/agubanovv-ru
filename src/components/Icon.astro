---
interface Props { name?: 'arrow' | 'folder' | 'article' | 'tag' | 'copy' | 'telegram'; direction?: 'right' | 'left' | 'down'; size?: number }
const { name = 'arrow', direction = 'right', size = 20 } = Astro.props;
---
<svg class:list={['icon', { [`icon-${direction}`]: name === 'arrow' }]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'copy' && <><rect x="8" y="8" width="12" height="13" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" /></>}
  {name === 'telegram' && <><circle cx="12" cy="12" r="10.5" /><path d="m5.5 11.5 12-4.7-2.1 10.3-4.1-3.1-2.2 1.9.5-3.6 5.8-3.5-7.2 2.8Z" fill="currentColor" stroke-width=".6" /></>}
  {name === 'arrow' && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {name === 'folder' && <path d="M3 7V5h7l2 2h9v12H3V7Zm0 3h18" />}
  {name === 'article' && <><path d="M5 3h10l4 4v14H5V3Zm10 0v5h4M9 12h6m-6 4h6" /></>}
  {name === 'tag' && <><path d="m3 12 9-9h9v9l-9 9-9-9Z" /><circle cx="17" cy="7" r="1" /></>}
</svg>
