---
import { site } from '@/lib/site-config';
import { asset } from '@/lib/utils';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-row">
    <p>© {year} {site.wordmark}</p>
    <nav aria-label="Контакты">
      <a href={`mailto:${site.contact.email}`}>Почта</a>
      <a href={`https://t.me/${site.contact.telegram.replace(/^@/, '')}`} rel="noopener">Telegram</a>
      <a href={asset('/rss.xml')}>RSS</a>
    </nav>
  </div>
</footer>
<style>
  .site-footer {
    margin-block-start: var(--spacing-section);
    border-block-start: 1px solid var(--c-line);
  }
  .footer-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    padding-block: 32px;
    font: var(--type-body-3);
    letter-spacing: var(--tracking-body-3);
    color: var(--c-muted);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    color: var(--c-secondary-ink);
  }
</style>
