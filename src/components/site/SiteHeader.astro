---
import { nav, site } from '@/lib/site-config';
import { p } from '@/lib/utils';

const clean = (href: string) => href.replace(/\/+$/, '') || '/';
const current = clean(Astro.url.pathname);
const isActive = (href: string) => {
  const target = clean(href);
  return target === '/' ? current === '/' : current === target || current.startsWith(`${target}/`);
};
---

<header class="site-header glass" data-header>
  <div class="shell header-row">
    <a class="wordmark" href={p('/')} aria-label={site.title}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path
          d="M4 19V7.5A3.5 3.5 0 0 1 7.5 4H19"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"></path>
        <path
          d="M10 19v-6.2A2.8 2.8 0 0 1 12.8 10H19"
          fill="none"
          stroke="var(--c-accent)"
          stroke-width="2.2"
          stroke-linecap="round"></path>
      </svg>
      <span>{site.wordmark}</span>
    </a>

    <nav class="desk-only main-nav" aria-label="Основная навигация">
      {
        nav
          .filter((item) => item.href !== '/')
          .map((item) => (
            <a
              class="nav-link"
              href={p(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              title={item.hint}
            >
              {item.label}
            </a>
          ))
      }
    </nav>

    <div class="header-actions">
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        aria-label="Переключить тему"
        aria-pressed={false}
        title="Тема: светлая / тёмная"
      >
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <path
            d="M12 2.6v2.4M12 19v2.4M2.6 12h2.4M19 12h2.4M5.4 5.4l1.7 1.7M16.9 16.9l1.7 1.7M18.6 5.4l-1.7 1.7M7.1 16.9l-1.7 1.7"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.6 8.6 0 1 0 10.6 10.6Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"></path>
        </svg>
      </button>

      <a class="desk-only btn btn-ghost btn-sm" href={`mailto:${site.contact.email}`} data-cta>Написать</a>

      <button
        class="icon-btn desk-hidden"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-nav-mobile"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" data-icon-open>
          <path d="M4 8h16M4 16h10" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" fill="none"></path>
        </svg>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" data-icon-close>
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" fill="none"
          ></path>
        </svg>
        <span class="sr-only">Меню</span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="site-nav-mobile" data-menu hidden>
    <nav class="shell" aria-label="Мобильная навигация">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={p(item.href)} aria-current={isActive(item.href) ? 'page' : undefined} data-menu-link>
                <span class="mobile-nav-label">{item.label}</span>
                <span class="mobile-nav-hint">{item.hint}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-nav-foot">
        <a class="btn btn-primary btn-sm" href={`mailto:${site.contact.email}`}>Написать</a>
        <a
          class="btn btn-ghost btn-sm"
          href={`https://t.me/${site.contact.telegram.replace(/^@/, '')}`}
          rel="noopener noreferrer"
        >
          Telegram
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-theme-toggle]');
  const menuButton = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-menu]');

  const root = document.documentElement;
  const KEY = 'site-theme';

  function syncPressed() {
    if (!toggle) return;
    toggle.setAttribute('aria-pressed', String(root.getAttribute('data-theme') === 'dark'));
  }
  syncPressed();

  toggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    root.style.colorScheme = next;
    try {
      localStorage.setItem(KEY, next);
    } catch {
      /* приватный режим: тема просто не запомнится */
    }
    syncPressed();
    window.dispatchEvent(new CustomEvent('site:theme', { detail: next }));
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    let stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch {}
    if (stored) return;
    const next = event.matches ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    syncPressed();
  });

  function setMenu(open: boolean) {
    if (!menu || !menuButton) return;
    menu.toggleAttribute('hidden', !open);
    menu.setAttribute('data-open', String(open));
    menuButton.setAttribute('aria-expanded', String(open));
    root.classList.toggle('nav-open', open);
  }

  menuButton?.addEventListener('click', () => setMenu(menu?.hasAttribute('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1280) setMenu(false);
  });

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      header?.toggleAttribute('data-scrolled', window.scrollY > 6);
      ticking = false;
    });
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style is:global>
  :root {
    --header-h: 60px;
  }

  @media (min-width: 1280px) {
    :root {
      --header-h: 72px;
    }
  }

  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    border-radius: 0;
    border-inline: 0;
    border-block-start: 0;
    border-block-end: 1px solid var(--c-line);
    background: var(--glass-bg-strong);
  }

  .site-header[data-scrolled] {
    background: var(--glass-bg);
    border-block-end-color: var(--glass-border);
  }

  .header-row {
    block-size: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 9px;

    font: var(--type-body-3);
    letter-spacing: var(--tracking-body-3);

    text-transform: lowercase;
    text-decoration: none;
    color: var(--c-ink);
    flex: none;
  }

  .wordmark svg {
    color: var(--c-ink);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    font: var(--type-body-2);
    letter-spacing: var(--tracking-body-2);
    color: var(--c-muted);
    text-decoration: none;
    transition:
      color var(--duration-base) var(--ease-glide),
      background-color var(--duration-base) var(--ease-glide);
  }

  .nav-link:hover {
    color: var(--c-ink);
    background: var(--c-accent-tint);
  }

  .nav-link[aria-current='page'] {
    color: var(--c-ink);
    background: var(--c-bg-sunk);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    inline-size: 38px;
    block-size: 38px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--c-line);
    background: transparent;
    color: var(--c-ink-soft);
    cursor: pointer;
    transition:
      background-color var(--duration-base) var(--ease-glide),
      color var(--duration-base) var(--ease-glide),
      border-color var(--duration-base) var(--ease-glide);
  }

  .icon-btn:hover {
    background: var(--c-accent-tint);
    color: var(--c-ink);
    border-color: var(--c-accent);
  }

  [data-theme='light'] .icon-sun {
    display: none;
  }

  [data-theme='dark'] .icon-moon {
    display: none;
  }

  /* Какую из двух иконок показывать, решает aria-expanded — он стоит без скрипта. */
  [data-icon-close] {
    display: none;
  }

  [data-menu-toggle][aria-expanded='true'] [data-icon-close] {
    display: block;
  }

  [data-menu-toggle][aria-expanded='true'] [data-icon-open] {
    display: none;
  }

  .mobile-nav {
    border-block-start: 1px solid var(--c-line);
    background: var(--c-surface);
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 10px 0 4px;
  }

  .mobile-nav li + li {
    border-block-start: 1px solid var(--c-line);
  }

  .mobile-nav a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 13px 2px;
    text-decoration: none;
    color: var(--c-ink);
  }

  .mobile-nav a[aria-current='page'] .mobile-nav-label {
    color: var(--c-accent);
  }

  .mobile-nav-label {
    font: var(--type-subtitle-1);
    letter-spacing: var(--tracking-subtitle-1);
  }

  .mobile-nav-hint {
    font: var(--type-body-3);
    letter-spacing: var(--tracking-body-3);
    color: var(--c-muted);
  }

  .mobile-nav-foot {
    display: flex;
    gap: 8px;
    padding-block: 12px 18px;
  }

  .nav-open {
    overflow: hidden;
  }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .desk-only {
    display: none;
  }

  @media (min-width: 1280px) {
    .desk-only {
      display: inline-flex;
    }

    .desk-hidden {
      display: none;
    }
  }
</style>
