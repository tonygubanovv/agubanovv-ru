---
import Icon from './Icon.astro';
import { shareServices } from '../config/site';
import { absoluteUrl } from '../utils/urls';
import { typograph } from '../utils/typography';
interface Props { path: string; title: string }
const { path, title } = Astro.props;
const address = absoluteUrl(path);
const destinations = shareServices.map(service => {
  const target = new URL(service.endpoint);
  if (service.urlParam) target.searchParams.set(service.urlParam, address);
  target.searchParams.set(service.titleParam, service.urlParam ? typograph(title) : `${typograph(title)}\n${address}`);
  return { label: service.label, href: target.href };
});
---
<div class="article-share" data-article-share>
  <div class="article-share-actions">
    <button class="button secondary" type="button" data-copy-article={address} hidden><span data-copy-icon><Icon name="copy" size={16} /></span><span data-copy-check hidden><Icon name="check" size={16} /></span><span>Скопировать ссылку</span></button>
    <details class="article-share-options">
      <summary class="button secondary"><Icon name="share" size={16} /><span>Поделиться</span></summary>
      <nav class="article-share-links" aria-label="Поделиться статьёй">{destinations.map(destination => <a href={destination.href} target="_blank" rel="noopener noreferrer">{destination.label}<Icon size={16} /></a>)}</nav>
    </details>
  </div>
  <p class="article-share-status" role="status" aria-live="polite" aria-atomic="true" data-share-status></p>
  <template data-share-success>Ссылка скопирована</template>
  <template data-share-error>Не удалось скопировать. Скопируйте ссылку из адресной строки.</template>
</div>
<script>
  import { copyText } from '../utils/clipboard';
  document.querySelectorAll<HTMLElement>('[data-article-share]').forEach(root => {
    const button = root.querySelector<HTMLButtonElement>('[data-copy-article]');
    const status = root.querySelector<HTMLElement>('[data-share-status]');
    const icon = root.querySelector<HTMLElement>('[data-copy-icon]');
    const check = root.querySelector<HTMLElement>('[data-copy-check]');
    const details = root.querySelector<HTMLDetailsElement>('details');
    const summary = details?.querySelector('summary');
    if (!button || !status || !icon || !check) return;
    button.hidden = false;
    let busy = false;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      if (busy) return;
      busy = true;
      window.clearTimeout(timer);
      status.textContent = '';
      icon.hidden = false;
      check.hidden = true;
      try {
        await copyText(button.dataset.copyArticle!);
        icon.hidden = true;
        check.hidden = false;
        status.textContent = root.querySelector<HTMLTemplateElement>('[data-share-success]')!.content.textContent;
      } catch {
        status.textContent = root.querySelector<HTMLTemplateElement>('[data-share-error]')!.content.textContent;
      } finally {
        busy = false;
      }
      timer = window.setTimeout(() => {
        icon.hidden = false;
        check.hidden = true;
        status.textContent = '';
      }, 5000);
    });
    root.addEventListener('keydown', event => {
      if (event.key === 'Escape' && details?.open) {
        details.open = false;
        summary?.focus();
      }
    });
    document.addEventListener('click', event => {
      if (details?.open && event.target instanceof Node && !details.contains(event.target)) details.open = false;
    });
  });
</script>
