---
import Icon from './Icon.astro';
import { shareServices } from '../config/site';
import { absoluteUrl } from '../utils/urls';
import { typograph } from '../utils/typography';
interface Props { path: string; title: string }
const { path, title } = Astro.props;
const address = absoluteUrl(path);
const destinations = shareServices.map(service => {
  const target = new URL(service.endpoint);
  target.searchParams.set(service.urlParam, address);
  target.searchParams.set(service.titleParam, typograph(title));
  return { label: service.label, icon: service.icon, href: target.href };
});
---
<div class="article-share" data-article-share>
  <span class="article-share-label">Поделиться</span>
  <nav class="article-share-actions" aria-label="Поделиться статьёй">
    {destinations.map(destination => <a class="article-share-control" href={destination.href} target="_blank" rel="noopener noreferrer" aria-label={`Поделиться в ${destination.label}`} aria-describedby={`share-${destination.icon}`}><Icon name={destination.icon} /><span class="article-share-tooltip" role="tooltip" id={`share-${destination.icon}`}>{destination.label}</span></a>)}
    <button class="article-share-control" type="button" data-copy-article={address} aria-label="Скопировать ссылку на статью" aria-describedby="share-copy" hidden><span data-copy-icon><Icon name="link" /></span><span data-copy-check hidden><Icon name="check" /></span><span class="article-share-tooltip" role="tooltip" id="share-copy" data-copy-feedback>Скопировать ссылку</span></button>
  </nav>
  <span class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-share-status></span>
  <template data-share-default>Скопировать ссылку</template>
  <template data-share-success>Ссылка скопирована</template>
  <template data-share-error>Не удалось скопировать</template>
</div>
<script>
  import { copyText } from '../utils/clipboard';
  document.querySelectorAll<HTMLElement>('[data-article-share]').forEach(root => {
    const button = root.querySelector<HTMLButtonElement>('[data-copy-article]');
    const status = root.querySelector<HTMLElement>('[data-share-status]');
    const icon = root.querySelector<HTMLElement>('[data-copy-icon]');
    const check = root.querySelector<HTMLElement>('[data-copy-check]');
    const feedback = root.querySelector<HTMLElement>('[data-copy-feedback]');
    if (!button || !status || !icon || !check || !feedback) return;
    button.hidden = false;
    let busy = false;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      if (busy) return;
      busy = true;
      window.clearTimeout(timer);
      status.textContent = '';
      icon.hidden = false;
      check.hidden = true;
      delete button.dataset.copyState;
      try {
        await copyText(button.dataset.copyArticle!);
        icon.hidden = true;
        check.hidden = false;
        status.textContent = root.querySelector<HTMLTemplateElement>('[data-share-success]')!.content.textContent;
      } catch {
        status.textContent = root.querySelector<HTMLTemplateElement>('[data-share-error]')!.content.textContent;
      } finally {
        busy = false;
      }
      feedback.textContent = status.textContent;
      button.dataset.copyState = 'feedback';
      timer = window.setTimeout(() => {
        icon.hidden = false;
        check.hidden = true;
        status.textContent = '';
        feedback.textContent = root.querySelector<HTMLTemplateElement>('[data-share-default]')!.content.textContent;
        delete button.dataset.copyState;
      }, 2600);
    });
    root.addEventListener('keydown', event => {
      if (event.key === 'Escape') root.dataset.tooltipDismissed = 'true';
    });
    root.addEventListener('pointerover', () => { delete root.dataset.tooltipDismissed; });
    root.addEventListener('focusin', () => { delete root.dataset.tooltipDismissed; });
  });
</script>
