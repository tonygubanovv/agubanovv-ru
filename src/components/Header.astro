---
import { site, links, mainMenu } from '../config/site';
import { url } from '../utils/urls';
import EmailContact from './EmailContact.astro';
import Icon from './Icon.astro';
import MenuLinks from './MenuLinks.astro';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={url()} aria-label={`${site.name} — главная`}>
      <span>{site.name}<span class="brand-dot">.</span></span>
    </a>
    <div class="header-actions">
    <nav class="desktop-nav" aria-label="Основная навигация">
      <MenuLinks items={mainMenu} compact />
    </nav>
    <div class="header-contacts">
      <EmailContact tooltipId="header-email-tooltip" />
      {links.telegram && <a class="telegram-contact" href={links.telegram} aria-label="Telegram Антона Губанова"><Icon name="telegram" size={28} /></a>}
    </div>
    <div class="header-controls">
      <details class="mobile-nav">
        <summary aria-label="Меню сайта"><span class="menu-open-icon"><Icon name="menu" /></span><span class="menu-close-icon"><Icon name="close" /></span></summary>
        <nav class="mobile-menu-panel" aria-label="Мобильная навигация">
          <MenuLinks items={mainMenu} />
          <div class="mobile-menu-contacts">
            <p class="menu-label">Связаться</p>
            {links.email && <div class="menu-contact-row"><Icon name="mail" size={20} /><a href={`mailto:${links.email}`}>{links.email}</a></div>}
            {links.telegram && <div class="menu-contact-row"><Icon name="telegram-plane" size={28} /><a href={links.telegram} target="_blank" rel="noopener noreferrer">Telegram</a></div>}
          </div>
        </nav>
      </details>
    </div>
    </div>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
  menu?.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('pointerdown', event => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
  menu?.addEventListener('focusout', event => {
    if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
  });
  window.matchMedia('(max-width: 1000px)').addEventListener('change', () => { if (menu) menu.open = false; });
  const header = document.querySelector<HTMLElement>('.site-header');
  let lastY = window.scrollY;
  const hideDistance = 120;
  const revealDistance = 64;
  const topVisibleZone = 120;
  let scrollAnchor = lastY;
  let scheduled = false;
  const updateHeader = () => {
    // Ignore elastic overscroll at either end of the page.
    const maxY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
    const y = Math.min(maxY, Math.max(0, window.scrollY));
    const delta = y - lastY;
    if (delta !== 0) {
      const focused = document.activeElement;
      const keyboardFocus = focused instanceof HTMLElement && focused.matches(':focus-visible');
      // Focusing a link can scroll the page automatically. Keep keyboard navigation inside the panel open.
      if (menu?.open && !(keyboardFocus && menu.contains(focused))) menu.open = false;
      if (!keyboardFocus && focused instanceof HTMLElement && header?.contains(focused)) focused.blur();
    }
    if (y <= topVisibleZone || header?.contains(document.activeElement)) {
      header?.classList.remove('is-hidden');
      scrollAnchor = y;
    } else if (header?.classList.contains('is-hidden')) {
      scrollAnchor = Math.max(scrollAnchor, y);
      if (scrollAnchor - y >= revealDistance) {
        header.classList.remove('is-hidden');
        scrollAnchor = y;
      }
    } else {
      // Measure from the furthest point, so small direction changes do not toggle the header.
      scrollAnchor = Math.min(scrollAnchor, y);
      if (y - scrollAnchor >= hideDistance) {
        header?.classList.add('is-hidden');
        scrollAnchor = y;
      }
    }
    lastY = y;
    scheduled = false;
  };
  window.addEventListener('scroll', () => {
    if (!scheduled) { scheduled = true; requestAnimationFrame(updateHeader); }
  }, { passive: true });
  const revealHeader = () => {
    header?.classList.remove('is-hidden');
    scrollAnchor = Math.max(0, window.scrollY);
  };
  header?.addEventListener('focusin', revealHeader);
  menu?.addEventListener('toggle', () => { if (menu.open) revealHeader(); });
</script>

<style>
  .mobile-nav { position: static; }
  .mobile-nav summary { display: grid; place-items: center; width: var(--tap); height: var(--tap); list-style: none; border: 1px solid var(--border); border-radius: var(--radius-md); color: var(--foreground); }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav[open] summary, .mobile-nav summary:active { color: var(--accent); background: var(--card-background); }
  @media (hover: hover) and (pointer: fine) {
    .mobile-nav summary:hover { color: var(--accent); background: var(--card-background); }
  }
  .menu-open-icon, .menu-close-icon { display: flex; }
  .menu-close-icon, .mobile-nav[open] .menu-open-icon { display: none; }
  .mobile-nav[open] .menu-close-icon { display: flex; }
  .mobile-nav::details-content { transition: content-visibility 240ms allow-discrete; }
  .mobile-menu-panel { position: absolute; top: 100%; inset-inline: 0; max-height: calc(100dvh - var(--header-h)); overflow-y: auto; overscroll-behavior: contain; padding: var(--space-3) var(--gutter) var(--space-5); background: var(--surface); border-bottom: 1px solid var(--border); box-shadow: 0 var(--space-4) var(--space-6) rgb(0 0 0 / 20%); }
  /* The panel uses the same quiet glass as the header, but needs its own backdrop. */
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    /* An ancestor backdrop-filter isolates the panel from the page behind it. */
    :global(.site-header:has(.mobile-nav[open])) { -webkit-backdrop-filter: none; backdrop-filter: none; }
    .mobile-menu-panel {
      background: color-mix(in srgb, var(--background) 86%, transparent);
      -webkit-backdrop-filter: blur(16px) saturate(110%);
      backdrop-filter: blur(16px) saturate(110%);
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .mobile-menu-panel { background: var(--surface); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
  @supports selector(details::details-content) {
    .mobile-menu-panel { opacity: 0; transform: translateY(calc(-1 * var(--space-2))); transition: opacity 240ms ease, transform 240ms ease; }
    .mobile-nav[open] .mobile-menu-panel { opacity: 1; transform: translateY(0); }
    @starting-style { .mobile-nav[open] .mobile-menu-panel { opacity: 0; transform: translateY(calc(-1 * var(--space-2))); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav::details-content, .mobile-menu-panel { transition: none; }
  }
  :global(body:has(.cookie-notice:not([hidden]))) .mobile-menu-panel { max-height: calc(100dvh - var(--header-h) - var(--cookie-notice-height, var(--space-7)) - env(safe-area-inset-bottom)); }
  .mobile-menu-contacts { display: grid; gap: var(--space-2); border-top: 1px solid var(--border); padding-top: var(--space-4); margin-top: var(--space-3); }
  .menu-label { color: var(--muted); font-size: var(--text-1); }
  .menu-contact-row { display: grid; grid-template-columns: var(--space-5) minmax(0, 1fr); align-items: center; gap: var(--space-2); padding-inline: var(--space-3); border-inline: 1px solid transparent; }
  .menu-contact-row > :global(.icon) { justify-self: center; color: var(--muted); }
  .menu-contact-row > a { display: flex; align-items: center; min-height: var(--tap); font-size: var(--text-2); font-weight: 500; overflow-wrap: anywhere; color: var(--foreground); }
  .menu-contact-row > a:focus-visible, .menu-contact-row > a:active { color: var(--accent); }
  @media (hover: hover) and (pointer: fine) {
    .menu-contact-row > a:hover { color: var(--accent); }
  }
</style>
