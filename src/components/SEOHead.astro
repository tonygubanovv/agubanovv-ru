---
import { site } from '../config/site';
import { isClosedPath } from '../utils/routes';
import { absoluteUrl, url } from '../utils/urls';
import onestCyrillic from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
interface Props { title: string; seoTitle?: string; description: string; path?: string; noindex?: boolean; article?: boolean; image?: string; imageAlt?: string; jsonLd?: Record<string, unknown> | Record<string, unknown>[] }
const { title, seoTitle, description, path = '', noindex = false, article = false, image, imageAlt, jsonLd } = Astro.props;
const graphs = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const fullTitle = seoTitle ?? `${title} — ${site.name}`;
const canonical = absoluteUrl(path);
// A page the owner closed keeps no canonical at all; a temporarily locked site only loses noindex.
const closed = noindex || isClosedPath(path);
const hidden = closed || !site.search.indexingEnabled;
const ogImage = image ? new URL(image, import.meta.env.SITE).href : absoluteUrl('og.png');
---
<meta charset="utf-8" />
<meta name="yandex-verification" content={site.verification.yandex} />
<meta name="google-site-verification" content={site.verification.google} />
<meta name="msvalidate.01" content={site.verification.bing} />
<link rel="preload" href={onestCyrillic} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta name="description" content={description} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<title>{fullTitle}</title>
{hidden && <meta name="robots" content="noindex, follow" />}
{!closed && <link rel="canonical" href={canonical} />}
<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
<meta property="og:locale" content="ru_RU" />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt ?? 'Маркетинг. С мыслью о главном.'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt ?? 'Маркетинг. С мыслью о главном.'} />
{graphs.map(graph => <script is:inline type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />)}
<script is:inline>
  try {
    const theme = localStorage.getItem('theme');
    if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
  } catch { /* System theme remains available without storage. */ }
</script>
